{
  "manifest_version": 3,
  "name": "Auditor de Prompts (DLP para IA)",
  "short_name": "Auditor IA",
  "version": "0.2.0",
  "version_name": "0.2.0-dev (incluye localhost:5500 para test.html)",
  "description": "Captura y clasifica localmente los prompts enviados a ChatGPT, Claude y Gemini. Proyecto académico IBERO.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Auditor de Prompts",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": ["patterns.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost:5500/*", "http://127.0.0.1:5500/*"],
      "js": ["patterns.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["overlay.css"],
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "http://localhost:5500/*",
        "http://127.0.0.1:5500/*"
      ]
    }
  ]
}
